# PDD Platform Environment Configuration
# Copy to .env and fill in. Run with: node --env-file=.env server.js
PORT=3000
NODE_ENV=production

# PostgreSQL (Neon). Leave empty to use local SQLite (pdd_database.db)
DATABASE_URL=

# Random string, at least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Admin login and password (applied to the existing admin account on every startup; other data is untouched)
ADMIN_USERNAME=
ADMIN_PASSWORD=
